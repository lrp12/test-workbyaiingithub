{"id":"chatcmpl-691606d34db0a1f230917322","object":"chat.completion","created":1763051220,"model":"kimi-k2-0905-preview","choices":[{"index":0,"message":{"role":"assistant","content":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"zh-CN\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003ctitle\u003e现代计算器\u003c/title\u003e\n\u003cstyle\u003e\n* {\n  box-sizing: border-box;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n}\nbody {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);\n}\n.calculator {\n  width: 320px;\n  background: #ffffff;\n  border-radius: 24px;\n  box-shadow: 0 20px 40px rgba(0,0,0,.15);\n  padding: 24px;\n}\n.display {\n  background: #f1f3f5;\n  color: #212529;\n  font-size: 2.2rem;\n  text-align: right;\n  padding: 16px;\n  border-radius: 12px;\n  margin-bottom: 16px;\n  min-height: 64px;\n  overflow: hidden;\n  word-break: break-all;\n}\n.buttons {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n}\nbutton {\n  font-size: 1.4rem;\n  padding: 18px 0;\n  border: none;\n  border-radius: 12px;\n  cursor: pointer;\n  background: #e9ecef;\n  color: #212529;\n  transition: background .2s;\n}\nbutton:hover {\n  background: #dee2e6;\n}\nbutton:active {\n  transform: scale(.96);\n}\n.operator {\n  background: #4dabf7;\n  color: #fff;\n}\n.operator:hover {\n  background: #339af0;\n}\n.equals {\n  background: #37b24d;\n  color: #fff;\n  grid-column: span 2;\n}\n.equals:hover {\n  background: #2f9e44;\n}\n.clear {\n  background: #f03e3e;\n  color: #fff;\n}\n.clear:hover {\n  background: #e03131;\n}\n.zero {\n  grid-column: span 2;\n}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cdiv class=\"calculator\"\u003e\n  \u003cdiv class=\"display\" id=\"display\"\u003e0\u003c/div\u003e\n  \u003cdiv class=\"buttons\"\u003e\n    \u003cbutton class=\"clear\" onclick=\"clearDisplay()\"\u003eC\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('/')\" class=\"operator\"\u003e÷\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('*')\" class=\"operator\"\u003e×\u003c/button\u003e\n    \u003cbutton onclick=\"deleteLast()\"\u003e←\u003c/button\u003e\n\n    \u003cbutton onclick=\"appendValue('7')\"\u003e7\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('8')\"\u003e8\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('9')\"\u003e9\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('-')\" class=\"operator\"\u003e−\u003c/button\u003e\n\n    \u003cbutton onclick=\"appendValue('4')\"\u003e4\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('5')\"\u003e5\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('6')\"\u003e6\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('+')\" class=\"operator\"\u003e+\u003c/button\u003e\n\n    \u003cbutton onclick=\"appendValue('1')\"\u003e1\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('2')\"\u003e2\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('3')\"\u003e3\u003c/button\u003e\n    \u003cbutton onclick=\"appendValue('.')\"\u003e.\u003c/button\u003e\n\n    \u003cbutton onclick=\"appendValue('0')\" class=\"zero\"\u003e0\u003c/button\u003e\n    \u003cbutton onclick=\"calculate()\" class=\"equals\"\u003e=\u003c/button\u003e\n  \u003c/div\u003e\n\u003c/div\u003e\n\n\u003cscript\u003e\nlet current = '0';\nlet shouldReset = false;\n\nfunction updateDisplay() {\n  document.getElementById('display').textContent = current;\n}\n\nfunction clearDisplay() {\n  current = '0';\n  shouldReset = false;\n  updateDisplay();\n}\n\nfunction appendValue(val) {\n  if (shouldReset) {\n    current = '0';\n    shouldReset = false;\n  }\n  if (current === '0' \u0026\u0026 val !== '.') {\n    current = val;\n  } else {\n    current += val;\n  }\n  updateDisplay();\n}\n\nfunction deleteLast() {\n  if (current.length \u003e 1) {\n    current = current.slice(0, -1);\n  } else {\n    current = '0';\n  }\n  updateDisplay();\n}\n\nfunction calculate() {\n  try {\n    current = String(eval(current));\n    shouldReset = true;\n  } catch (e) {\n    current = '错误';\n    shouldReset = true;\n  }\n  updateDisplay();\n}\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e"},"finish_reason":"stop"}],"usage":{"prompt_tokens":46,"completion_tokens":1026,"total_tokens":1072}}
